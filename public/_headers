/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Explicit preview-host isolation, even if a future production build contains
# indexable HTML and a production-domain canonical. This is only a second
# defense; the live custom-domain launch still requires a host-by-host check.
https://quilt-calculator-566.pages.dev/*
  X-Robots-Tag: noindex, follow

https://:version.quilt-calculator-566.pages.dev/*
  X-Robots-Tag: noindex, follow
