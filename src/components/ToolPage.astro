---
import type {ToolRoute} from '../data/routes';
import {routes} from '../data/routes';
import Calculator from './Calculator.astro';
import IntentGuide from './IntentGuide.astro';
import QuickAnswer from './QuickAnswer.astro';
import {guides} from '../data/intent-guides';
interface Props {route:ToolRoute}
const {route}=Astro.props;
const related=guides[route.id].related.map(id=>routes.find(t=>t.id===id)!);
const toolImageAlt:Record<string,string>={
 hub:'Quilt project planner illustration showing a fabric cutting workspace',
 backing:'Quilt backing calculator illustration showing fabric panels for a quilt back',
 binding:'Straight-grain quilt binding calculator illustration showing full-width binding strips',
 borders:'Butted quilt border calculator illustration showing side-first and top-and-bottom border pieces',
 yardage:'Fabric yardage calculator illustration showing repeated rectangular cuts on a fabric roll',
 fabric:'Quilt fabric calculator illustration showing separate color-specific fabric cut layouts',
 inches:'Fabric yard conversion chart showing common yard fractions and their lengths in inches',
 batting:'Quilt batting calculator illustration showing a single-piece fit against roll width',
 sashing:'Quilt sashing calculator illustration showing a block grid with internal sashing and cornerstones'
};
---
<div class="page-shell">
<nav class="seo-breadcrumb" aria-label="Breadcrumb">
 <a href="/">Home</a><span aria-hidden="true">›</span>
 {route.id==='hub'
  ? <span aria-current="page">All calculators</span>
  : <><a href="/calculators/">All calculators</a><span aria-hidden="true">›</span><span aria-current="page">{route.nav}</span></>}
</nav>
<div class="page-intro page-intro--tool" data-ui-hero data-tool-intent={route.id}>
<div class="page-heading"><span class="eyebrow-with-line">— {route.nav.toUpperCase()} / FREE ONLINE TOOL</span><h1>{route.h1}</h1><p class="answer-first-lead" data-answer-first={route.id}><strong>Quick answer:</strong> {route.formula}</p><p>{route.intro}</p><div class="feature-pills"><span>{route.id==='inches'?'✓ Exact conversions':'✓ Feasible layouts'}</span><span>{route.id==='inches'?'✓ Fractions explained':'✓ Live yardage'}</span><span>✓ No sign-up</span></div><div class="hero-actions"><a href="#calculator-workspace" class="hero-main-cta">Start calculating <span aria-hidden="true">↗</span></a><a href="/calculators/" class="hero-sub-cta">View all nine tools</a></div></div>
<div class="mini-feature mini-feature--crafted"><div class="mini-top"><span>MADE FOR REAL FABRIC</span><span>01 / 03</span></div><img src={'/images/'+route.id+'.webp'} width="640" height="420" alt={toolImageAlt[route.id] || route.nav+' calculator illustration'} loading="eager"/>
<svg class="hero-thread" viewBox="0 0 580 280" preserveAspectRatio="none" aria-hidden="true"><path d="M-12 185 Q 75 95, 154 156 T 321 144 T 598 70" pathLength="100" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="1.2 1.2" stroke-linecap="round"/></svg><div class="mini-bottom"><b>Plan it once.</b><span>Cut it with confidence ✳</span></div></div>
</div>
{route.id==='inches'&&
<section class="seo-direct-answer" aria-label="Quick yard to inch answers" data-seo-direct-answer>
  <div class="seo-direct-answer-text">
    <span class="eyebrow-with-line">— QUICK ANSWER</span>
    <h2>How many inches are in one yard of fabric?</h2>
    <p><strong>One linear yard of fabric is exactly 36 inches (91.44 centimeters) long.</strong> The width is not fixed: measure the usable width on your own fabric bolt.</p>
    <p>A quarter yard is <strong>9 inches</strong>, a half yard is <strong>18 inches</strong>, one and a half yards is <strong>54 inches</strong>, and four yards is <strong>144 inches</strong>. These are lengths, not fixed fabric areas or retailer prices.</p>
    <p><strong>Reverse conversion works here too:</strong> 9 inches = ¼ yard, 18 inches = ½ yard, and 22.86 centimeters = 9 inches = ¼ yard. Choose Yards, Inches, or Centimeters as the input unit above the value field. Changing the unit preserves the same length rather than reinterpreting the number. Decimal outputs are rounded for readability; the internal calculation retains its numerical precision.</p>
    <a href="#fraction-reference">See the full fractions and centimeters chart</a>
  </div>
  <div class="seo-direct-answer-metric" aria-label="One yard equals 36 inches"><strong>1 yd</strong><span>=</span><strong>36 in</strong><small>Exact linear measure</small></div>
</section>}
<Calculator tool={route.id} sample={route.sample}/>
<QuickAnswer tool={route.id}/>
{route.id==='hub'&&
<section class="content-block" data-seo-size-examples>
 <h2>Which quilt size should I start with?</h2>
 <p>Baby/crib, throw, twin, queen and king are <strong>illustrative finished OUTSIDE quilt sizes, not standardized dimensions</strong>. The quick examples in the planner fill in overall quilt measurements; existing borders and color-by-color fabric cut lists are not recreated. Check your pattern, batting and backing requirements before buying.</p>
</section>}
{route.id==='backing'&&
<section class="content-block" data-seo-backing-width-comparison>
 <h2>Is 108-inch wide backing cheaper than regular quilting cotton?</h2>
 <p>Not always. Compare the <strong>usable fabric width after trimming selvedges</strong>, the panel/seam count, rounded purchase yardage and the price per yard for each real bolt. Wide backing may need fewer seams and fewer yards, but its price per yard can be higher. The calculator's second-width table is a hypothetical estimate only: the current width still owns the cutting plan and exported shopping list.</p>
 <p>Both scenarios preserve the same quilt outside dimensions, backing overage, seam take-up, one-way print restriction, selected seam direction and purchase rounding step. Taxes, shipping, seam labor and pattern matching are not included.</p>
</section>}
{route.id==='binding'&&
<section class="content-block" data-seo-bias-area-bound>
 <h2>Can I use this calculator for bias binding?</h2>
 <p>This calculator covers straight-grain, full-width-of-fabric strips only. Bias binding uses 45° cuts and a different geometry; its fabric yield and purchase quantity are not calculated here. Do not use this page’s yardage or cut list for bias tape or curved-edge binding; this page does not provide an approved purchasing plan for bias binding. The separate noindex <a href="/lab/individual-bias-strips/">individual 45° strip</a>, <a href="/lab/continuous-bias-tube/">continuous-bias tube topology</a> and <a href="/lab/continuous-bias-planner/">continuous-bias planning</a> labs are research only; none provides a validated purchase quantity.</p>
</section>}
{route.id==='sashing'&&
<section class="content-block" data-seo-block-grid-handoff>
 <h2>How do finished blocks and sashing determine quilt size?</h2>
 <p>Center width = columns × finished block width + (columns − 1) × finished sashing width. Center height = rows × finished block height + (rows − 1) × finished sashing width. For a 4-row × 5-column grid of 10-inch blocks with 2-inch internal sashing, the quilt center is <strong>58 × 46 inches</strong>, before any outside borders.</p>
 <p>Use the button in the calculator to pass these center measurements into your shared Project Planner. Outer borders are added afterwards. That action does not create any fabric color/SKU cutting list or confirm a sewing layout.</p>
 <h2>How does the Reverse quilt block size calculator find dimensions from a target center?</h2>
 <p>For straight-set blocks with <strong>internal sashing only</strong>, the reverse formula is: finished block width = (target center width − (columns − 1) × finished sashing width) ÷ columns; finished block height = (target center height − (rows − 1) × finished sashing width) ÷ rows. For example, a <strong>60 × 80 inch center</strong> using 5 columns, 4 rows and 2-inch internal sashing requires finished rectangular blocks of <strong>10.4 × 18.5 inches</strong>. Check whether these sizes suit your actual pattern.</p>
 <p>This reverse result describes <strong>FINISHED block dimensions</strong>, not fabric cutting dimensions. Quilt borders are separate; adding an existing 3-inch finished border on every side makes that 60 × 80 inch center a 66 × 86 inch outside quilt. The calculator does not infer angled/on-point blocks, exterior sashing frames or colored fabric-cut lists. If the internal strips consume the entire target, the calculator refuses the request.</p>
</section>}
<section class="content-block"><div class="editorial-head"><span class="eyebrow-with-line">— UNDER THE STITCHES</span><h2>How does this calculator turn measurements into fabric cuts?</h2><p>Understand the calculation before cutting into fabric.</p></div>
<div class="story-grid"><article class="story-panel"><span class="story-number">01 / FORMULA</span><h3>How it works</h3><p>{route.formula}</p></article><article class="story-panel"><span class="story-number">02 / METHOD</span><h3>From measurements to fabric</h3><p>{route.method}</p></article><article class="story-panel disclaimer-panel"><span class="story-number">03 / IMPORTANT</span><h3>What it does not assume</h3><p>{route.caution}</p></article></div>
</section>
<section class="sample-block"><div><span class="eyebrow-with-line">— THE WORKED EXAMPLE</span><h2>What does this worked example show?</h2><p>{route.sample}</p></div><span class="sample-icon" aria-hidden="true">✳</span></section>
<IntentGuide tool={route.id}/>
<section class="content-block" data-geo-provenance>
 <h2>How to verify these calculations</h2>
 <p>The <a href="https://github.com/garrison2025/Quilt_Calculator/blob/main/src/lib/quilt/math.ts" target="_blank" rel="noopener noreferrer">open calculation engine</a> and <a href="https://github.com/garrison2025/Quilt_Calculator/tree/main/tests" target="_blank" rel="noopener noreferrer">automated reference tests</a> document the implemented formulas and edge cases. They are implementation evidence, not a sewing certification or a guarantee of minimum material waste.</p>
 <p>Our <a href="/about/#sources">measurement references</a> distinguish standard unit definitions and independent quilting guidance from the assumptions used by this tool. The calculator's live results depend on your entered dimensions and materials.</p>
</section>
<p class="methodology-link">Want to check how these estimates are calculated or report a problem? Read our <a href="/about/#methods">cutting and purchase methodology</a>, with limitations and source-code references.</p>
<section class="faq-block"><div><span class="eyebrow-with-line">— COMMON QUESTIONS</span><h2>What questions should I check before cutting fabric?</h2></div><div class="faq-list">{route.faqs.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
<section class="related-block"><span class="eyebrow-with-line">— KEEP MAKING</span><h2>Which calculator should I use next?</h2><div class="related-grid">{related.map(r=><a href={'/'+r.slug+'/'} class="related-card"><span class="related-ornament">✳</span><span>{r.nav}</span><strong>{r.h1}</strong><small>Open calculator ↗</small></a>)}</div></section>
</div>
