---
import type {ToolId} from '../client/types';
import {geoSources} from '../data/geo-sources';
interface Props {tool:ToolId}
const {tool}=Astro.props;
const sources=geoSources[tool];
---
<div class="geo-citations" data-geo-citations={tool} aria-label="Independent references">
 <h3>Which independent references explain this method?</h3>
 <ul>
  {sources.map(source=><li>
   <a href={source.url} target="_blank" rel="noopener noreferrer">{source.publisher} — {source.title}</a>
   <p>{source.scope}</p>
  </li>)}
 </ul>
 <p class="geo-citation-note">These references describe general quilting practice or measurement standards; they do not certify this calculator's outputs. The exact formulas, input assumptions and unsupported construction methods are disclosed on this page and in the <a href="https://github.com/garrison2025/Quilt_Calculator">public source code</a>.</p>
</div>
