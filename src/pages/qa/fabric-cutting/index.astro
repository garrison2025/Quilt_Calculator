 .qa-fabric-field-grid input,.qa-fabric-field-grid select{box-sizing:border-box;min-width:0;width:100%;min-height:46px;padding:9px 11px;border:1px solid #98b9a0;border-radius:8px;background:white;color:#223e2b;font:500 14px/1.4 system-ui}
 .qa-fabric-field-grid input:focus-visible,.qa-fabric-field-grid select:focus-visible,.qa-fabric-audit button:focus-visible{outline:3px solid #47855e;outline-offset:2px}
