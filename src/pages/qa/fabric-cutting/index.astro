 .qa-fabric-confirm{display:flex;gap:10px;align-items:start;line-height:1.7;font-size:13px;font-weight:650;margin:23px 0;cursor:pointer}
 .qa-fabric-confirm input{width:19px;height:19px;flex-shrink:0;accent-color:#25774e;margin-top:2px}
 .qa-fabric-buttons{display:flex;gap:12px;flex-wrap:wrap;margin:17px 0}
 .qa-fabric-audit button:disabled{opacity:.52;cursor:not-allowed}
 [data-fabric-result],[data-fabric-import-status]{border:1px solid #a7c6a9;background:#ecf5eb;border-radius:8px;padding:13px;margin-top:13px;line-height:1.6;font-size:13px;overflow-wrap:anywhere}
 [data-fabric-assessment="USER_REPORTED_SHORTAGE_OR_DEVIATION"],
 [data-fabric-assessment="USER_REPORTED_SHRINKAGE_EXCEEDS_PLAN"],
 [data-fabric-assessment="USER_REPORTED_SEAM_LOSS_EXCEEDS_PLAN"],
 [data-fabric-assessment="USER_REPORTED_SEAM_DIRECTION_MISMATCH"],
 [data-fabric-assessment="USER_REPORTED_SEAM_MEASUREMENTS_DISAGREE"],
 [data-fabric-assessment="USER_REPORTED_FINISH_MEASUREMENTS_DISAGREE"],
 [data-fabric-assessment="USER_REPORTED_BACKING_TRIM_SHORTFALL"],
 [data-fabric-assessment="USER_REPORTED_SEWN_TOP_SIZE_DEVIATION"],
 [data-fabric-assessment="INCONCLUSIVE_NOT_POSTWASHED"]{border-color:#d1ad79;background:#fff0df;color:#7d3e16}
 @media(max-width:650px){.qa-fabric-field-grid{grid-template-columns:1fr}.qa-fabric-audit{padding-block:22px 55px}}
 @media(prefers-color-scheme:dark){
  .qa-fabric-audit-card,.qa-fabric-roll{background:#1e3225;border-color:#52745a;color:#e4f1e6}
  .qa-fabric-audit-intro h1,.qa-fabric-audit-card h2,.qa-fabric-field-grid label,.qa-fabric-roll h3,[data-fabric-finishing-area] summary{color:#e3f0e3}
  .qa-fabric-field-grid input,.qa-fabric-field-grid select,.qa-fabric-seam-item input,.qa-fabric-seam-item select{background:#132c1c;color:#fff;border-color:#72917a}
  [data-fabric-result],[data-fabric-import-status]{background:#244630;color:#e7f5e9;border-color:#67936a}
  [data-fabric-assessment="USER_REPORTED_SHORTAGE_OR_DEVIATION"],
  [data-fabric-assessment="USER_REPORTED_SHRINKAGE_EXCEEDS_PLAN"],
  [data-fabric-assessment="USER_REPORTED_SEAM_LOSS_EXCEEDS_PLAN"],
  [data-fabric-assessment="USER_REPORTED_SEAM_DIRECTION_MISMATCH"],
  [data-fabric-assessment="USER_REPORTED_SEAM_MEASUREMENTS_DISAGREE"],
