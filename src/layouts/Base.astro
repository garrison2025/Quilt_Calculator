---
import '../styles/site.css';
import { routes, type ToolRoute } from '../data/routes';
interface Props {route?:ToolRoute;home?:boolean;title?:string;description?:string;noIndex?:boolean}
const {route,home=false,title,description,noIndex=false}=Astro.props;
const pageTitle=title||route?.title||'Quilt Studio';
const pageDescription=description||route?.meta||'Free quilting cutting calculators.';
const candidate=import.meta.env.PUBLIC_SITE_URL||'';
const approved=!noIndex&&import.meta.env.PUBLIC_INDEXABLE==='1'&&/^https:\/\/[^/]+$/i.test(candidate)&&!/\.pages\.dev$|localhost|127\.0\.0\.1/i.test(candidate);
const canonical=approved ? candidate+Astro.url.pathname : undefined;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content={pageDescription}/>
<meta name="robots" content={approved?'index,follow,max-image-preview:large':'noindex,follow'}/>
<meta name="theme-color" content="#f8f6f1"/>
{canonical&&<link rel="canonical" href={canonical}/>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<title>{pageTitle}</title>
<meta property="og:title" content={pageTitle}/><meta property="og:description" content={pageDescription}/><meta property="og:type" content="website"/>
{!noIndex && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:pageTitle,description:pageDescription,applicationCategory:'UtilitiesApplication',operatingSystem:'Any modern browser',isAccessibleForFree:true,...(canonical?{url:canonical}:{})})}/>}
{approved && route && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:candidate+'/'},{'@type':'ListItem',position:2,name:route.nav,item:canonical}]})}/>}
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header"><div class="header-inner">
<a href="/" class="brand"><span class="brand-icon">✳</span><span>quilt<span class="brand-em">studio</span><small>MADE TO MEASURE</small></span></a>
<nav class="desktop-nav" aria-label="Primary navigation">{routes.filter(r=>['hub','backing','binding','borders','yardage'].includes(r.id)).map(r=><a href={'/'+r.slug+'/'} class:list={{active:route?.id===r.id}}>{r.nav}</a>)}</nav>
<a href="/calculators/" class="header-cta">All tools ↗</a>
<details class="mobile-tools"><summary>Tools <span aria-hidden="true">⌄</span></summary><nav aria-label="Mobile calculators">{routes.map(r=><a href={'/'+r.slug+'/'}>{r.nav}</a>)}</nav></details>
</div></header>
<main id="main"><slot/></main>
{route && <aside class="print-scale-audit" aria-label="Physical print size verification before cutting" data-print-scale-audit>
 <h2>PRINT SCALE CHECK · MEASURE BEFORE CUTTING</h2>
 <p>Print at <strong>100% / Actual size</strong>. Disable “Fit to page”, “Shrink oversized pages” and browser scaling. Check both marks using a real ruler. If either measurement is inaccurate, correct printer settings and reprint.</p>
 <div class="print-scale-rulers">
  <div class="print-inch-gauge" data-print-inch-gauge role="img" aria-label="One-inch square. Both sides must physically measure exactly one inch."></div>
  <div class="print-scale-label"><strong>1 in × 1 in</strong><small>Verify both width and height on paper.</small></div>
 </div>
 <div class="print-mm-gauge" data-print-mm-gauge role="img" aria-label="Horizontal line which must measure exactly 100 millimeters on printed paper."></div>
 <p class="print-scale-label"><strong>100 mm reference line</strong> · should measure 10 cm with a physical ruler.</p>
 <p><strong>Note:</strong> all illustrated cutting diagrams remain schematics, not full-size templates. Passing this paper-size check does not validate sewing or cutting geometry.</p>
</aside>}
<footer class="site-footer"><div class="footer-inner">
<div><a href="/" class="footer-mark">quiltstudio ✳</a><p>Thoughtful tools for confident cutting. No account or subscription required.</p></div>
<div class="footer-links"><strong>Calculators</strong>{routes.map(r=><a href={'/'+r.slug+'/'}>{r.nav}</a>)}</div>
<div class="footer-links"><strong>Good to know</strong><span>US English • inches by default</span><span>Measurements stay in your browser</span><span>Plans are not 1:1 sewing patterns</span><span>Check fabric specifications before cutting</span><a href="/privacy/">Privacy &amp; local data</a></div>
</div><div class="footer-bottom"><span>© 2026 Quilt Studio.</span><span>Made for real fabric, not guesswork.</span></div></footer>
</body></html>
